{
  "name": "@alexandryn/desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Alexandryn desktop host — Electron main process, preload, and the disk-loaded boot asset (architecture-desktop-host.md, phase 05).",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "pretest": "go build -o test-helpers/test-server/test-server ./test-helpers/test-server",
    "test": "vitest run --passWithNoTests",
    "pretest:e2e": "go build -o test-helpers/test-server/test-server ./test-helpers/test-server",
    "test:e2e": "playwright test"
  },

  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
