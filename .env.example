# Local Supabase/PostgreSQL dev stack (ADR 0004). Start it with `supabase start`,
# then copy this file to .env and confirm the URL matches `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Required, no default (backend-configuration.md FR-3) — a placeholder
# value here would misidentify this client to Open Library's real API,
# which is exactly what the "required, no default" category exists to
# prevent. Set your own descriptive User-Agent string.
# OPEN_LIBRARY_USER_AGENT=

# Container target only (deployment-container-packaging.md FR-4) — used
# by docker-compose.yml's bundled-db profile to create the Postgres
# instance and compute backend's DATABASE_URL. Not read by `go run
# ./cmd/server` directly; irrelevant to the local Supabase dev stack
# above. Defaults shown are docker-compose.yml's own fallback if unset.
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin
# POSTGRES_DB=alexandryn
