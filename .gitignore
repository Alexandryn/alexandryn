# ---- Secrets and local configuration -------------------------------------
# Never relax these without a review. Anything matching here is assumed to
# contain credentials until proven otherwise.
.env
.env.*
!.env.example
docker-compose.override.yml
!docker-compose.override.yml.example
*.pem
*.key
!**/testdata/**/*.key
*.p12
*.keystore
secrets.json
credentials.json

# ---- Node / frontend -------------------------------------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/plugins
!.yarn/versions
dist/
build/
# electron-builder's own convention: source-controlled packaging inputs
# (icons, entitlements), not build output — the generic build/ ignore
# above would otherwise also catch this.
!electron/build/
!electron/build/**
out/
.next/
.vite/
*.tsbuildinfo
.eslintcache
coverage/
.nyc_output/

# ---- Go / backend ----------------------------------------------------------
bin/
*.exe
*.test
*.out
vendor/
# ...except the deliberately vendored frontend library (foliate-js, ADR 0023).
!web/src/vendor/
__debug_bin*
electron/test-helpers/test-server/test-server


# ---- Electron / packaging --------------------------------------------------
release/
dist-electron/
*.dmg
*.AppImage
*.snap
*.deb
*.rpm
*.msi

# ---- Test artefacts --------------------------------------------------------
playwright-report/
test-results/
blob-report/
.playwright/
*.lcov

# ---- Local runtime data ----------------------------------------------------
# The host writes cached files here during dev. The library itself lives in
# PostgreSQL (ADR 0004), not a file on disk.
.data/

# ---- Local PostgreSQL / Supabase dev tooling --------------------------------
# `supabase init` (ADR 0004) writes its own supabase/.gitignore for
# .branches/.temp. config.toml and migrations/ are tracked on purpose.

# ---- Editors and OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.recommended.json

# ---- Logs ------------------------------------------------------------------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- docs repo draft content -------------------------------------------
# Per ADR 0006, user-facing documentation lives in a separate `docs`
# repo, not here. This is a local staging area for that content until
# the repo exists (Phase 99, Step 6) — never committed to this repo.
docs-draft/
