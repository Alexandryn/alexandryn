# Workspace install: keep each package's deps nested in its own
# node_modules, no hoisting to the root. web/ builds against vite 8,
# electron/ against vite 7 (electron-vite 5's peer range) — hoisting
# put both in the root node_modules and web/'s tsc saw the wrong one
# (rolldownVersion / Plugin-not-assignable). Nested keeps them apart.
install-strategy=nested
